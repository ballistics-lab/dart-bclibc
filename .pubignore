# Not part of the published package. (pub uses this file *instead of*
# .gitignore, so build output is excluded here as well.)
.github/
scripts/
Makefile
# py-ballisticcalc's test suite driven against this package (python/ engines + tool/py_bridge)
tool/
python/
.dart_tool/
build/
coverage/
pubspec.lock

# bclibc is a submodule: the hook compiles bclibc/src, bclibc/include only.
bclibc/tests/
bclibc/tiny_bclibc/
bclibc/build/
bclibc/.github/

# example/ stays (pub.dev shows it); its Flatpak packaging is CI-only.
example/flatpak/
example/app/
example/flutpak.yaml
